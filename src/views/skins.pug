//skins.pug
doctype html
html(lang="pt-br")
  head
    title Coleção Sonhos e Pesadelos
    meta(charset="UTF-8")
    style.
      body { font-family: Arial, sans-serif; padding: 24px; background: #111; color: #f5f5f5; }
      h1 { margin-bottom: 20px; }
      table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
      th, td { border: 1px solid #333; padding: 12px; }
      th { background: #222; text-transform: uppercase; font-size: 0.85rem; }
      tr:nth-child(even) { background: #1a1a1a; }
      .raridade-secreto { background: #8b0000; color: #fff; }
      .raridade-oculto { background: #9932cc; color: #fff; }
      .raridade-classificado { background: #ff69b4; color: #111; }
      .raridade-restrito { background: #1e90ff; color: #fff; }
      .raridade-militar { background: #228b22; color: #fff; }
      .badge { border-radius: 6px; padding: 4px 10px; display: inline-block; }
  body
    h1 Coleção Sonhos e Pesadelos
    table
      thead
        tr
          th Arma
          th Skin
          th Raridade
          th Caixa ID
      tbody
        each skin in skins
          - const badgeClass = 'raridade-' + skin.raridade.toLowerCase().replace(/\s+/g, '-');
          tr
            td= skin.arma
            td= skin.nome_skin
            td(class=badgeClass)= skin.raridade
            td= skin.caixa_id
