doctype html
html(lang="pt-br")
  head
    title CS2 Inventory — Perfil
    meta(charset="UTF-8")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;600;700&display=swap")
    style.
      *{box-sizing:border-box;margin:0;padding:0}
      body{font-family:'Rajdhani',sans-serif;background:#0d0d14;color:#c0c4d8;min-height:100vh}
      nav{display:flex;align-items:center;justify-content:space-between;padding:10px 24px;background:#07070d;border-bottom:1px solid #1e2030}
      .logo{font-size:12px;color:#e8b84b;letter-spacing:3px;text-transform:uppercase;font-weight:700}
      .nav-links a{padding:8px 18px;border:1px solid #2a2d45;color:#7b8099;font-family:'Rajdhani',sans-serif;font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-decoration:none;border-radius:4px;margin-left:4px;transition:all .15s}
      .nav-links a:hover{border-color:#e8b84b;color:#e8b84b}
      .nav-links a.active{background:#e8b84b;border-color:#e8b84b;color:#0a0a0f}
      main{padding:28px 24px;max-width:900px}
      .perfil-header{display:flex;align-items:center;gap:20px;margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid #1e2030}
      .avatar{width:64px;height:64px;background:linear-gradient(135deg,#e8b84b,#c49a2d);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;color:#0a0a0f;flex-shrink:0}
      h1{font-size:26px;font-weight:700;color:#f0f0f8;letter-spacing:1px}
      .badge{display:inline-block;margin-top:4px;padding:3px 10px;background:#1a1d2e;border:1px solid #e8b84b;border-radius:3px;font-size:12px;color:#e8b84b;letter-spacing:2px;text-transform:uppercase}
      .saldo{margin-top:6px;font-size:13px;color:#5a5f7a}
      .saldo span{color:#e8b84b;font-weight:700}
      .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:28px}
      .stat-card{background:#11131f;border:1px solid #1e2030;border-radius:8px;padding:18px;text-align:center}
      .stat-card .val{font-size:36px;font-weight:700;color:#e8b84b}
      .stat-card .lbl{font-size:11px;color:#5a5f7a;letter-spacing:2px;text-transform:uppercase;margin-top:4px}
      .section-label{font-size:11px;color:#5a5f7a;letter-spacing:2px;text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:8px}
      .section-label::after{content:'';flex:1;height:1px;background:#1e2030}
      .skin-item{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:#11131f;border:1px solid #1e2030;border-radius:6px;margin-bottom:6px}
      .skin-item .arma{font-size:14px;color:#f0f0f8;font-weight:600}
      .skin-item .nome{font-size:13px;color:#7b8099}
      .skin-item .data{font-size:11px;color:#5a5f7a;margin-top:2px}
      .r-badge{font-size:11px;padding:3px 8px;border-radius:3px;font-weight:700;letter-spacing:1px;text-transform:uppercase}
      .covert{background:#3d0a0a;color:#ff5252;border:1px solid #8b0000}
      .classified{background:#1e0a3d;color:#b84fff;border:1px solid #6a0dad}
      .restricted{background:#0a1a3d;color:#5294ff;border:1px solid #1e4dbf}
      .mil-spec{background:#0a2a10;color:#52c47a;border:1px solid #1a6e35}
      .rare-special{background:#3d2a00;color:#ffcc00;border:1px solid #a07800}
      .empty{color:#5a5f7a;font-size:14px;padding:20px 0}
  body
    nav
      span.logo CS2 Inventory
      div.nav-links
        a(href="/perfil" class="active") Perfil
        a(href="/caixas/view") Caixas
        a(href="/skins/view") Skins
    main
      div.perfil-header
        div.avatar= jogador.nome ? jogador.nome.slice(0,2).toUpperCase() : 'J1'
        div
          h1= jogador.nome
          span.badge= jogador.patente
          p.saldo Saldo:
            span  $#{jogador.saldo}
      div.stats-grid
        div.stat-card
          div.val= estatisticas.caixas
          div.lbl Caixas
        div.stat-card
          div.val= estatisticas.chaves
          div.lbl Chaves
        div.stat-card
          div.val= estatisticas.skins
          div.lbl Skins no BD
        div.stat-card
          div.val= inventarioSkins.length
          div.lbl No inventário
      div.section-label Inventário do jogador
      if inventarioSkins.length === 0
        p.empty Nenhuma skin ainda. Abra caixas via POST /caixas/:id/abrir
      each skin in inventarioSkins
        - const rc = skin.raridade ? skin.raridade.toLowerCase().replace(/\s+/g,'-') : ''
        div.skin-item
          div
            div.arma= skin.arma
            div.nome= skin.nome_skin
            div.data= skin.obtidoEm ? new Date(skin.obtidoEm).toLocaleString('pt-BR') : ''
          span(class=`r-badge ${rc}`)= skin.raridade