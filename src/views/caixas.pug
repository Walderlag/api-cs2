doctype html
html(lang="pt-br")
  head
    title CS2 Inventory — Caixas
    meta(charset="UTF-8")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;600;700&display=swap")
    style.
      *{box-sizing:border-box;margin:0;padding:0}
      body{font-family:'Rajdhani',sans-serif;background:#0d0d14;color:#c0c4d8;min-height:100vh}
      nav{display:flex;align-items:center;justify-content:space-between;padding:10px 24px;background:#07070d;border-bottom:1px solid #1e2030}
      .logo{font-size:12px;color:#e8b84b;letter-spacing:3px;text-transform:uppercase;font-weight:700}
      .nav-links a{padding:8px 18px;border:1px solid #2a2d45;color:#7b8099;font-family:'Rajdhani',sans-serif;font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-decoration:none;border-radius:4px;margin-left:4px;transition:all .15s}
      .nav-links a:hover{border-color:#e8b84b;color:#e8b84b}
      .nav-links a.active{background:#e8b84b;border-color:#e8b84b;color:#0a0a0f}
      main{padding:28px 24px;max-width:900px}
      .section-label{font-size:11px;color:#5a5f7a;letter-spacing:2px;text-transform:uppercase;margin-bottom:14px;display:flex;align-items:center;gap:8px}
      .section-label::after{content:'';flex:1;height:1px;background:#1e2030}
      .caixa-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin-bottom:32px}
      .caixa-card{background:#11131f;border:1px solid #1e2030;border-radius:8px;padding:20px;position:relative;overflow:hidden}
      .caixa-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#e8b84b,transparent)}
      .caixa-card .c-nome{font-size:17px;font-weight:700;color:#f0f0f8;margin-bottom:4px}
      .caixa-card .c-colecao{font-size:12px;color:#5a5f7a;letter-spacing:1px;text-transform:uppercase}
      .chave-item{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:#11131f;border:1px solid #1e2030;border-radius:6px;margin-bottom:6px}
      .chave-item .c-nome{font-size:15px;color:#f0f0f8;font-weight:600}
      .qty-badge{background:#1a2510;border:1px solid #3a6020;color:#7cc04a;font-size:12px;padding:3px 12px;border-radius:3px;font-weight:700;letter-spacing:1px}
  body
    nav
      span.logo CS2 Inventory
      div.nav-links
        a(href="/perfil") Perfil
        a(href="/caixas/view" class="active") Caixas
        a(href="/skins/view") Skins
    main
      div.section-label Caixas disponíveis
      div.caixa-grid
        each caixa in caixas
          div.caixa-card
            div.c-nome= caixa.nome
            div.c-colecao= caixa.colecao
      div.section-label Chaves
      each chave in chaves
        div.chave-item
          span.c-nome= chave.nome
          span.qty-badge ×#{chave.quantidade}