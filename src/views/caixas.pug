//caixas.pug
doctype html
html(lang="pt-br")
  head
    title= titulo
    meta(charset="UTF-8")
    style.
      body { font-family: Arial, sans-serif; padding: 24px; background: #111; color: #f5f5f5; }
      h1 { margin-bottom: 20px; }
      table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
      th, td { border: 1px solid #333; padding: 12px; }
      th { background: #222; text-transform: uppercase; font-size: 0.85rem; }
      tr:nth-child(even) { background: #1a1a1a; }
  body
    h1= titulo
    h2 Caixas
    table
      thead
        tr
          th ID
          th Nome
          th Coleção
      tbody
        each caixa in caixas
          tr
            td= caixa.id
            td= caixa.nome
            td= caixa.colecao
    h2 Chaves
    table
      thead
        tr
          th ID
          th Nome
          th Quantidade
      tbody
        each chave in chaves
          tr
            td= chave.id
            td= chave.nome
            td= chave.quantidade